generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}
enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
}
enum DiscountType {
  PERCENT
  FLAT
}
model User {
  id String @id @default(cuid())
  firebaseUid String @unique
  name String @default("")
  email String?
  phone String?
  photoUrl String?
  fcmToken String?
  createdAt DateTime @default(now())
  addresses Address[]
  orders Order[]
  reviews Review[]
  wallet Wallet?
  wishlist Wishlist[]
  cart CartItem[]
  @@map("users")
}
// Everyone who signs into the admin panel. `role` decides which pages they
// get: ADMIN sees all of them, PACKING and SALES see only their own few.
model Admin {
  id String @id @default(cuid())
  name String @default("")
  email String @unique
  passwordHash String
  role String @default("ADMIN") // ADMIN | PACKING | SALES
  enabled Boolean @default(true)
  sessionVersion Int @default(0)
  createdAt DateTime @default(now())
  applications SellerApplication[]
  @@map("admins")
}
// A shopkeeper the sales team signed up, waiting for the admin to check the
// GST/Aadhaar details and hand out seller panel credentials.
model SellerApplication {
  id String @id @default(cuid())
  shopName String
  ownerName String
  phone String
  email String?
  address String
  gstNumber String?
  aadharNumber String?
  // Photos of the GST certificate, Aadhaar, shop front... (Cloudinary URLs).
  documents String[]
  status String @default("PENDING") // PENDING | APPROVED | REJECTED
  note String?
  submittedById String
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  submittedBy Admin @relation(fields: [submittedById], references: [id])
  seller Seller?
  @@index([status, createdAt])
  @@map("seller_applications")
}
// A shop selling through NTSA, with its own panel on a separate site.
model Seller {
  id String @id @default(cuid())
  shopName String
  ownerName String
  username String @unique
  passwordHash String
  email String?
  phone String
  gstNumber String?
  aadharNumber String?
  gstVerified Boolean @default(false)
  aadharVerified Boolean @default(false)
  enabled Boolean @default(true)
  deleted Boolean @default(false)
  sessionVersion Int @default(0)
  createdAt DateTime @default(now())
  application SellerApplication? @relation(fields: [applicationId], references: [id])
  applicationId String? @unique
  products Product[]
  items OrderItem[]
  @@map("sellers")
}
// Delivery charge slabs the admin sets, e.g. "under ₹500 costs ₹30". The
// cheapest matching slab wins; an order above every slab ships free.
model DeliveryRule {
  id String @id @default(cuid())
  // Applies when the items total is below this amount.
  belowPaise Int
  chargePaise Int
  createdAt DateTime @default(now())
  @@map("delivery_rules")
}
// PIN codes the shop refuses to deliver to, e.g. an area with repeated
// fake returns. Blocked at the address and at checkout, not just in the app.
model BlockedPincode {
  pincode String @id
  reason String?
  createdAt DateTime @default(now())
  @@map("blocked_pincodes")
}
// In-panel bell notifications (push to phones needs Firebase, which the
// client hasn't provided yet).
model Notification {
  id String @id @default(cuid())
  // Which panel role should see it: ADMIN, PACKING or SALES.
  audience String
  type String // ORDER_PACKED | SELLER_APPLICATION | SELLER_APPROVED ...
  title String
  body String
  entityId String?
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([audience, createdAt])
  @@map("notifications")
}
model Vendor {
  id String @id @default(cuid())
  name String
  username String @unique
  passwordHash String
  email String?
  phone String?
  // KYC captured when the super admin onboards a wholesale partner.
  // Note: storing a full Aadhaar number has its own compliance
  // considerations under the Aadhaar Act for non-UIDAI-authorized
  // entities -- flagged for the business to review, not enforced here.
  aadharNumber String?
  panNumber String?
  gstNumber String?
  // The admin ticks these off after checking the documents.
  gstVerified Boolean @default(false)
  aadharVerified Boolean @default(false)
  enabled Boolean @default(true)
  deleted Boolean @default(false)
  sessionVersion Int @default(0)
  createdAt DateTime @default(now())
  limits VendorLimit?
  orders Order[]
  messages VendorMessage[]
  @@map("vendors")
}
// A simple two-way thread between one wholesale buyer and the admin team,
// for the "message admin" option on the wholesale portal.
model VendorMessage {
  id String @id @default(cuid())
  vendorId String
  sender String // "VENDOR" | "ADMIN"
  body String
  // Photos or short clips sent with the message (Cloudinary URLs); a message
  // may be attachments only, with an empty body.
  attachments String[]
  createdAt DateTime @default(now())
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  @@index([vendorId, createdAt])
  @@map("vendor_messages")
}
model VendorLimit {
  id String @id @default(cuid())
  vendorId String @unique
  minPaise Int
  maxPaise Int
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  @@map("vendor_limits")
}
// The Home screen's top banner/slider -- fully admin-managed so a super
// admin can change its image, text and color without a code change.
model Banner {
  id String @id @default(cuid())
  title String
  subtitle String?
  imageUrl String?
  // A short clip instead of a still. The image, when both are set, is the
  // poster shown while the video loads.
  videoUrl String?
  backgroundColor String? // hex, e.g. "#13224A"; falls back to the app's default brand color when unset
  buttonText String @default("Shop Now")
  active Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  @@map("banners")
}
model Coupon {
  id String @id @default(cuid())
  code String @unique
  description String @default("")
  discountType DiscountType
  value Int // percent (1-100) or flat paise, per discountType
  minOrderPaise Int @default(0)
  maxDiscountPaise Int? // caps a PERCENT discount; ignored for FLAT
  usageLimit Int? // total redemptions allowed across all customers; null = unlimited
  usedCount Int @default(0)
  expiresAt DateTime?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@map("coupons")
}
model Category {
  id String @id @default(cuid())
  name String @unique
  icon String @default("shopping_bag")
  // How long a delivered product from this category can be returned for.
  // Set once per category by the admin; every product in it inherits it.
  refundWindowHours Int @default(24)
  // Whether refurbished / open-box stock makes sense here at all. A phone
  // or a sofa can be open-box; a bag of atta cannot, so the option only
  // appears on the categories the admin ticks.
  allowsUsedStock Boolean @default(false)
  products Product[]
  @@map("categories")
}
model Product {
  id String @id @default(cuid())
  name String
  description String
  pricePaise Int
  wholesalePaise Int
  mrpPaise Int?
  stock Int
  categoryId String
  // Whose stock this is. NTSA's own products have no seller; a shop that
  // sells through NTSA owns the ones it adds from the seller panel.
  sellerId String?
  images String[]
  // Variant options a shopper must pick from when present, e.g. shoe sizes
  // ["6", "7", "8"] or phone storage ["128GB", "256GB"]. sizeLabel names the
  // choice ("Size", "Storage", ...). Stock is shared across options.
  sizes String[]
  sizeLabel String @default("Size")
  // Optional per-option price override, e.g.
  // {"256GB": {"pricePaise": 1499900, "wholesalePaise": 1199900, "mrpPaise": 1799900}};
  // an option without an entry uses the product's own prices.
  sizePrices Json?
  // Optional {"Black": "https://...", "White": "https://..."} -- when a color
  // has a matching photo, the app shows that photo when the color is picked
  // instead of always showing the generic gallery.
  colorImages Json?
  // What a colour adds to the price, e.g. {"Red": 5000} for +50 rupees on
  // the retail, wholesale and MRP of whichever option is picked. Colours
  // that cost the same as the rest say nothing here.
  colorExtraPaise Json?
  colors String[]
  // Free-form extra specs an admin can add per product, e.g.
  // [{"label": "Capacity", "value": "20L"}, {"label": "Material", "value": "Nylon"}] --
  // for details that don't fit any fixed field (a bag's capacity, a phone's
  // RAM, etc). Shown as a "Specifications" list on the product page.
  attributes Json?
  // Most products are plain new stock; refurbished or open-box items say so
  // on the listing and the product page, with an optional line of detail.
  condition String @default("NEW") // NEW | REFURBISHED | OPEN_BOX | USED
  conditionNote String?
  // Who the product is listed for. Wholesale-only stock (bulk packs, dealer
  // lots) never shows in the shopping app, and retail-only stock never shows
  // in the wholesale portal.
  audience String @default("BOTH") // RETAIL | WHOLESALE | BOTH
  // Copied from the product's category whenever it is saved, so orders and
  // the app keep reading it straight off the product.
  refundWindowHours Int @default(24)
  deal Boolean @default(false)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  category Category @relation(fields: [categoryId], references: [id])
  seller Seller? @relation(fields: [sellerId], references: [id])
  orderItems OrderItem[]
  reviews Review[]
  wishlist Wishlist[]
  cart CartItem[]
  @@index([categoryId, active])
  @@index([sellerId, active])
  @@map("products")
}
model Address {
  id String @id @default(cuid())
  userId String
  name String
  phone String
  line1 String
  city String
  state String
  postalCode String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("addresses")
}
model Order {
  id String @id @default(cuid())
  userId String?
  vendorId String?
  status OrderStatus @default(PENDING_PAYMENT)
  totalPaise Int
  // What the delivery slab charged when the order was placed.
  deliveryPaise Int @default(0)
  couponCode String?
  discountPaise Int @default(0)
  address Json
  paymentMethod String
  paymentId String? @unique
  razorpayOrderId String? @unique
  checkoutKey String @unique
  deliveredAt DateTime?
  cancelledAt DateTime?
  // Who called it off and why, shown to the admin and on the packing slip.
  cancelledBy String? // CUSTOMER | VENDOR | ADMIN | SYSTEM
  cancelReason String?
  refundEligible Boolean @default(false)
  deliveryOtpHash String?
  deliveryOtpExpiresAt DateTime?
  deliveryOtpAttempts Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id])
  vendor Vendor? @relation(fields: [vendorId], references: [id])
  items OrderItem[]
  @@index([status, createdAt])
  @@map("orders")
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  name String
  quantity Int
  unitPaise Int
  // The variant the shopper picked, so the right size/color gets packed.
  size String?
  color String?
  // Copied from the product when the order is placed, so a seller's sales
  // stay theirs even if the product is edited or removed later.
  sellerId String?
  refundWindowHours Int
  refundExpiresAt DateTime?
  refundEligible Boolean @default(false)
  order Order @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  seller Seller? @relation(fields: [sellerId], references: [id])
  refund Refund?
  @@index([refundEligible, refundExpiresAt])
  @@index([sellerId])
  @@map("order_items")
}
model Refund {
  id String @id @default(cuid())
  orderItemId String @unique
  reason String
  status RefundStatus @default(REQUESTED)
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  @@map("refunds")
}
model Review {
  id String @id @default(cuid())
  userId String
  productId String
  rating Int
  comment String
  images String[]
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  @@unique([userId, productId])
  @@map("reviews")
}
model Wallet {
  id String @id @default(cuid())
  userId String @unique
  balancePaise Int @default(0)
  user User @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
  @@map("wallets")
}
model WalletTransaction {
  id String @id @default(cuid())
  walletId String
  amountPaise Int
  kind String
  reference String @unique
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id])
  @@map("wallet_transactions")
}
model Wishlist {
  userId String
  productId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@id([userId, productId])
  @@map("wishlists")
}
model CartItem {
  userId String
  productId String
  // "" when the product has no such option; part of the key so two sizes of
  // the same shoe are separate cart lines.
  size String @default("")
  color String @default("")
  quantity Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@id([userId, productId, size, color])
  @@map("cart_items")
}
